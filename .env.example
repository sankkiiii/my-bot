# ════════════════════════════════════════
# sexvoice Discord Bot — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════

# ── BOT CREDENTIALS ──────────────────────
# Get from https://discord.com/developers/applications
TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here

# ── SERVER CONFIG ────────────────────────
# Used for registering slash commands (deploy-commands.js)
GUILD_ID=your_server_id_here

# ── BOT SETTINGS ────────────────────────
# Default prefix for text commands
PREFIX=!

# Bot owners (comma separated user IDs, no spaces)
# Single owner:  OWNER_IDS=123456789
# Multiple:      OWNER_IDS=123456789,987654321,111222333
OWNER_IDS=your_discord_user_id_here

# ── VC PANEL IMAGE ───────────────────────
# Optional: URL to the VC control panel image shown in embed
# Leave empty to use text fields instead
# Host image on Discord CDN, Imgur, or GitHub raw
VC_PANEL_IMAGE=

# ════════════════════════════════════════
# NOTE: All channel/category IDs are configured
# inside Discord using /setup commands.
# No channel IDs needed in this file.
# ════════════════════════════════════════
